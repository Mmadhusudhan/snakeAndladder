# Copy to .env. Never commit .env or service account keys.
PORT=3000

# Firebase project (Admin SDK). One of:
#  - GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
#  - FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'   (JSON string)
# On Cloud Run / Cloud Functions leave both unset: default credentials are used.
FIREBASE_PROJECT_ID=car-game-e403f
# Realtime Database URL (Firebase console -> Realtime Database). Defaults to
# https://<project>-default-rtdb.firebaseio.com; set explicitly for other regions.
FIREBASE_DATABASE_URL=https://car-game-e403f-default-rtdb.asia-southeast1.firebasedatabase.app
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Comma-separated origins allowed to call the API (Flutter web / Firebase Hosting).
CORS_ORIGINS=http://localhost:5000,https://car-game-e403f.web.app
