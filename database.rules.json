{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": false,
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isBoolean() || newData.isNumber()"
          }
        }
      }
    },
    "users_rooms": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "codes": {
      ".read": false,
      ".write": false
    },
    "queue": {
      ".read": false,
      ".write": false
    }
  }
}
