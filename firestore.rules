rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function validStats(s) {
      return s.keys().hasOnly(['games','wins','losses','winStreak','bestWinTurns','totalTurns','snakes','ladders','rating'])
        && s.games is int && s.games >= 0 && s.games <= 100000
        && s.wins is int && s.wins >= 0 && s.wins <= s.games
        && s.losses is int && s.losses >= 0 && s.losses <= s.games
        && s.rating is int && s.rating >= 0 && s.rating <= 1000000;
    }

    // Public profiles: anyone signed in can read (needed for names on
    // leaderboards and in rooms). Only the owner writes their own document.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 16
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && validStats(request.resource.data.stats);
      allow update: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 16
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && validStats(request.resource.data.stats);
      allow delete: if false;
    }

    // Each user's own history. Casual games may be written by the client;
    // size and shape are bounded.
    match /game_history/{uid}/games/{matchId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 2
        && request.resource.data.players.size() <= 4
        && request.resource.data.turns is int
        && request.resource.data.turns >= 3
        && request.resource.data.winnerIndex is int;
      allow update, delete: if false;
    }

    // Leaderboards are read-only for clients; the backend (Admin SDK)
    // bypasses rules to write them.
    match /leaderboards/{period}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Online rooms (Phase 6) are managed by the backend.
    match /private_rooms/{code} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
